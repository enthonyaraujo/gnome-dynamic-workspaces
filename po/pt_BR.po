#: extension.js:311
#, javascript-format
msgid "Workspace %d: %s"
msgstr "Workspace %d: %s"

#: extension.js:316 prefs.js:268
#, javascript-format
msgid "Workspace %d"
msgstr "Workspace %d"

#: extension.js:379
msgid "Dynamic Workspaces"
msgstr "Workspaces Dinâmicas"

#: prefs.js:20
msgid "Behavior"
msgstr "Comportamento"

#: prefs.js:27
msgid "Workspaces Behavior"
msgstr "Comportamento das Workspaces"

#: prefs.js:28
msgid "Configure dynamic display and persistent workspaces"
msgstr "Configurar exibição dinâmica e workspaces persistentes"

#: prefs.js:34
msgid "Always visible workspaces"
msgstr "Workspaces sempre visíveis"

#: prefs.js:35
msgid ""
"The first N workspaces stay visible even when empty. The active workspace is "
"always shown."
msgstr ""
"As primeiras N workspaces permanecem visíveis mesmo vazias. A workspace "
"ativa é sempre exibida."

#: prefs.js:49
msgid "Maximum workspaces"
msgstr "Máximo de workspaces"

#: prefs.js:50
msgid "Maximum number of workspaces to show in the indicator."
msgstr "Número máximo de workspaces a serem exibidas no indicador."

#: prefs.js:64
msgid "Follow window when moving"
msgstr "Acompanhar foco ao mover janela"

#: prefs.js:65
msgid ""
"When moving active window to another workspace (Super+Shift+1..0), "
"automatically follow focus to target workspace (Hyprland movetoworkspace)."
msgstr ""
"Ao mover a janela ativa para outra workspace (Super+Shift+1..0), acompanha o "
"foco automaticamente para a workspace de destino (estilo Hyprland "
"movetoworkspace)."

#: prefs.js:72
msgid "Multi-Monitor"
msgstr "Múltiplos Monitores"

#: prefs.js:73
msgid "Multi-display occupancy filtering"
msgstr "Filtragem de ocupação por monitor"

#: prefs.js:78
msgid "Only count windows on this monitor"
msgstr "Contar apenas janelas neste monitor"

#: prefs.js:79
msgid ""
"When enabled, a workspace is considered occupied only if it contains windows "
"on the screen where the indicator is located."
msgstr ""
"Quando ativado, uma workspace só é considerada ocupada se contiver janelas "
"na tela onde o indicador está localizado."

#: prefs.js:86
msgid "Keyboard Shortcuts Reference"
msgstr "Referência de Atalhos de Teclado"

#: prefs.js:87
msgid "Configured system shortcuts for navigation and window management"
msgstr ""
"Atalhos configurados no sistema para navegação e gerenciamento de janelas"

#: prefs.js:93
msgid ""
"• <b>Super+1..9, Super+0</b> — Switch directly to workspace 1–10\n"
"• <b>Super+Shift+1..9, Super+Shift+0</b> — Move active window to workspace "
"and follow view\n"
"• <b>Left-Click</b> on any workspace pill — Switch to that workspace\n"
"• <b>Mouse Wheel Scroll</b> on the indicator — Cycle workspaces forward / "
"backward"
msgstr ""
"• <b>Super+1..9, Super+0</b> — Alternar diretamente para as workspaces 1–10\n"
"• <b>Super+Shift+1..9, Super+Shift+0</b> — Mover janela ativa para a "
"workspace e acompanhar foco\n"
"• <b>Clique com botão esquerdo</b> em qualquer pílula — Alternar para essa "
"workspace\n"
"• <b>Rolar a roda do mouse</b> sobre o indicador — Avançar / voltar entre "
"workspaces"

#: prefs.js:113
msgid "Visual"
msgstr "Visual"

#: prefs.js:120
msgid "Indicator Style"
msgstr "Estilo do Indicador"

#: prefs.js:121
msgid "Choose the visual presentation of the workspace indicator"
msgstr "Escolha a apresentação visual do indicador de workspace"

#: prefs.js:127
msgid "GNOME Puro"
msgstr "GNOME Puro"

#: prefs.js:128
msgid "Indicadores de uso"
msgstr "Indicadores de uso"

#: prefs.js:129
msgid "Cápsula sutil"
msgstr "Cápsula sutil"

#: prefs.js:130
msgid "Nomes dinâmicos"
msgstr "Nomes dinâmicos"

#: prefs.js:131
msgid "Transição animada"
msgstr "Transição animada"

#: prefs.js:134
msgid ""
"Indicador minimalista seguindo a linguagem visual padrão do GNOME Shell."
msgstr ""
"Indicador minimalista seguindo a linguagem visual padrão do GNOME Shell."

#: prefs.js:135
msgid "Mostra quais workspaces possuem janelas abertas com pontos discretos."
msgstr "Mostra quais workspaces possuem janelas abertas com pontos discretos."

#: prefs.js:136
msgid "Destaca o workspace atual com uma superfície discreta estilo Adwaita."
msgstr "Destaca o workspace atual com uma superfície discreta estilo Adwaita."

#: prefs.js:137
msgid "Permite exibir nomes personalizados para os workspaces."
msgstr "Permite exibir nomes personalizados para os workspaces."

#: prefs.js:138
msgid "Move suavemente o indicador ao trocar de workspace."
msgstr "Move suavemente o indicador ao trocar de workspace."

#: prefs.js:146
msgid "Indicator style"
msgstr "Estilo do indicador"

#: prefs.js:147
msgid "Select one of the 5 visual presentation modes"
msgstr "Selecione um dos 5 modos de apresentação visual"

#: prefs.js:157
msgid "About this style"
msgstr "Sobre este estilo"

#: prefs.js:164
msgid "Live Preview"
msgstr "Prévia Visual"

#: prefs.js:165
msgid "Preview of how the indicator will look in the top bar"
msgstr "Prévia de como o indicador aparecerá na barra superior"

#: prefs.js:252
msgid "Workspace Names"
msgstr "Nomes dos Workspaces"

#: prefs.js:253
msgid ""
"Custom names for dynamic workspaces. If left empty, only the number is shown."
msgstr ""
"Nomes personalizados para workspaces dinâmicas. Se vazio, apenas o número é "
"exibido."

#: prefs.js:298
msgid "Panel and Elements"
msgstr "Painel e Elementos"

#: prefs.js:299
msgid "Configure panel placement and complementary visual elements"
msgstr "Configurar posicionamento no painel e elementos visuais complementares"

#: prefs.js:309
msgid "Panel position"
msgstr "Posição no painel"

#: prefs.js:310
msgid "Position of the dynamic workspace pills on the GNOME top bar"
msgstr "Posição das pílulas dinâmicas na barra superior do GNOME"

#: prefs.js:312
msgid "Left"
msgstr "Esquerda"

#: prefs.js:312
msgid "Center"
msgstr "Centro"

#: prefs.js:312
msgid "Right"
msgstr "Direita"

#: prefs.js:324
msgid "Hide default workspace indicator"
msgstr "Ocultar indicador padrão de workspace"

#: prefs.js:325
msgid ""
"Hide the built-in GNOME activities / workspace dots button in the top bar."
msgstr ""
"Oculta o botão nativo de atividades / pontos de workspace do GNOME na barra "
"superior."

#: prefs.js:332
msgid "Show tooltip on hover"
msgstr "Exibir dica ao passar o mouse"

#: prefs.js:333
msgid "Show tooltip with workspace name when hovering over a pill."
msgstr ""
"Exibe uma dica com o nome da workspace ao passar o mouse sobre a pílula."
